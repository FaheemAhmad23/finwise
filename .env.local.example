# ─── Database ────────────────────────────────────────────────────────────────
# PostgreSQL connection string for your self-hosted server
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://finwise_user:your_password@your-server-ip:5432/finwise_db"

# ─── NextAuth ────────────────────────────────────────────────────────────────
# Generate a strong random secret:  openssl rand -base64 32
NEXTAUTH_SECRET="paste-your-generated-secret-here"

# Your app's public URL (change for production)
NEXTAUTH_URL="http://localhost:3000"

# ─── Google OAuth (optional) ─────────────────────────────────────────────────
# Get these from https://console.cloud.google.com → Credentials → OAuth 2.0 Client IDs
# Leave blank to disable Google login
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ─── Currency Exchange Rates (optional) ──────────────────────────────────────
# Free API key from https://app.exchangerate-api.com
EXCHANGE_RATE_API_KEY=""
