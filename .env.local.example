# ─────────────────────────────────────────────────────────────────────────────
# FinWise — Environment Variables
# Copy this file to .env and fill in your real values.
# NEVER commit the .env file to GitHub.
# ─────────────────────────────────────────────────────────────────────────────

# ── MySQL Database ────────────────────────────────────────────────────────────
# Password for the finwise_user account (make it strong)
DB_PASSWORD=Finwise@2026!

# Root password for MySQL (different from the app user password)
DB_ROOT_PASSWORD=RootFinwise@2026!

# ── NextAuth ──────────────────────────────────────────────────────────────────
# Random secret used to encrypt login sessions.
# Generate one by running:  openssl rand -base64 32
NEXTAUTH_SECRET=PASTE_YOUR_GENERATED_SECRET_HERE

# The URL where your app is publicly accessible.
# If you have no domain yet, use your server IP + port 3000.
NEXTAUTH_URL=http://168.144.35.138:3000

# ── Google OAuth (optional — leave blank to disable) ─────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
